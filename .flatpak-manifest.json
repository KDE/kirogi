        {
            "name": "gst-plugins-good",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://gstreamer.freedesktop.org/src/gst-plugins-good/gst-plugins-good-1.29.2.tar.xz",
                    "sha256": "4ce274d207bd7b404b8b07ed669b4ebac81849b23636e455b23150dee1e3595e",
