{
    "id": "org.kde.kirogi",
    "branch": "master",
    "rename-icon": "kirogi",
    "runtime": "org.kde.Platform",
    "runtime-version": "5.15-25.08",
    "sdk": "org.kde.Sdk",
    "command": "kirogi",
    "tags": [
        "nightly"
    ],
    "desktop-file-name-prefix": "(Nightly) ",
